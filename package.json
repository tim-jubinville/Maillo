{
  "name": "maillo",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "description": "A self-hosted web interface for Gmail.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "ios": "tsc --noEmit && MAILLO_NATIVE=1 vite build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "dompurify": "^3.4.18",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
