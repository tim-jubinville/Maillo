# Apache settings for a static install.
Options -Indexes
DirectoryIndex index.html
AddType application/manifest+json .webmanifest

<IfModule mod_alias.c>
  RedirectMatch 404 /\.(maillo|mailmax)-
</IfModule>

# maillo-config.php holds your settings and secrets. PHP reads it from disk; it is never
# served, not even as plain text if PHP stops working.
<FilesMatch "^(maillo-config|maillo-common)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # After the rule above, so these files are always checked for a newer version.
  <FilesMatch "^(index\.html|config\.php|sw\.js|manifest\.webmanifest|version\.json|branding\.json|update\.php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
